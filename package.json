{
  "name": "codebase",
  "version": "0.4.0",
  "private": true,
  "description": "A browser IDE for building websites, by hand or with AI.",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "prettier": "3.3.3"
  }
}
